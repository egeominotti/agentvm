#!/bin/bash
# Interactive Claude Code in the VM, as root and without any permission prompts.
# The token arrives only on fd 3: it is not in the environment of the commands Claude runs.
# The initial prompt is used only once.
set -euo pipefail
args=(--dangerously-skip-permissions)
if [ -s /run/agentvm/prompt ]; then
  prompt=$(cat /run/agentvm/prompt)
  rm -f /run/agentvm/prompt
  # An argument starting with "-" would be parsed as an option.
  [[ "$prompt" == -* ]] && prompt=" $prompt"
  args+=("$prompt")
fi
exec 3< /run/agentvm/token
IS_SANDBOX=1 CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR=3 exec /root/.local/bin/claude "${args[@]}"
