#!/bin/bash
# Interactive Claude Code in the VM, as root and without any permission prompts.
# The token arrives only on fd 3: it is not in the environment of the commands Claude runs.
# The initial prompt is used only once.
set -euo pipefail
args=(--dangerously-skip-permissions)
# A restored machine picks up its last conversation.
if [ -e /run/agentvm/continue ]; then rm -f /run/agentvm/continue; args+=(--continue); fi
if [ -s /run/agentvm/model ]; then args+=(--model "$(cat /run/agentvm/model)"); fi
if [ -s /run/agentvm/prompt ]; then
  prompt=$(cat /run/agentvm/prompt)
  rm -f /run/agentvm/prompt
  # An argument starting with "-" would be parsed as an option.
  [[ "$prompt" == -* ]] && prompt=" $prompt"
  args+=("$prompt")
fi
# Claude's colors follow the terminal's (Catppuccin Latte or Mocha, as the dashboard's theme): the
# image's old default "dark" becomes "auto", once per machine, so a theme chosen later with /theme
# stays, snapshots included.
if [ ! -e /root/.agentvm-theme-auto ] && [ -f /root/.claude.json ]; then
  sed -i 's/"theme": *"dark"/"theme": "auto"/' /root/.claude.json && touch /root/.agentvm-theme-auto
fi
exec 3< /run/agentvm/token
IS_SANDBOX=1 CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR=3 exec /root/.local/bin/claude "${args[@]}"
