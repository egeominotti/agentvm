#!/bin/bash
# Claude Code interattivo nella VM. Il token arriva solo su fd 3 (da un file leggibile da root):
# non è nell'ambiente dei comandi che Claude esegue. Il prompt iniziale si usa una sola volta.
set -euo pipefail
args=(--dangerously-skip-permissions)
if sudo test -s /run/agentvm/prompt; then
  prompt=$(sudo cat /run/agentvm/prompt)
  sudo rm -f /run/agentvm/prompt
  # Un argomento che inizia con "-" verrebbe letto come opzione.
  [[ "$prompt" == -* ]] && prompt=" $prompt"
  args+=("$prompt")
fi
exec 3< <(sudo cat /run/agentvm/token)
CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR=3 exec /home/agent/.local/bin/claude "${args[@]}"
