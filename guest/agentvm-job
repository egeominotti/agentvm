#!/bin/bash
# Runs the task described in /mnt/job/task.json (contract §3.6 of the spec) and powers off the VM.
# Never `set -x`: the token passes through this script.
set -euo pipefail

JOB=/mnt/job
WORK=/root/work
CLAUDE=/root/.local/bin/claude

log() { echo "[$(cut -d' ' -f1 /proc/uptime)s] $*" >> "$JOB/job.log"; }

write_result() { # status claude_exit commits [error]
  jq -n --arg s "$1" --argjson e "$2" --argjson c "$3" --arg err "${4:-}" \
    '{status:$s, claude_exit:$e, commits:$c} + (if $err == "" then {} else {error:$err} end)' \
    > "$JOB/result.json"
}

finish() {
  local rc=$?
  # Nothing may stop the power-off: a VM left on with no job runner would idle forever.
  set +e
  if [ ! -s "$JOB/result.json" ] && mountpoint -q "$JOB"; then
    write_result failed -1 0 "guest_error (exit $rc)"
  fi
  sync
  poweroff -f
}
trap finish EXIT

# Keeps a guest service running for the VM's whole life: restarted a second after it exits,
# whatever the reason (a crash, the out-of-memory killer). The power-off ends it.
keep_running() { # command...
  (
    set +e
    while true; do
      "$@"
      rc=$?
      log "$(basename "$1") exited ($rc): restarting"
      sleep 1
    done
  ) &
}

mkdir -p "$JOB"
mountpoint -q "$JOB" || mount -t virtiofs job "$JOB"
# Saving the work and answering the host's requests (shipped by the server with this script).
# shellcheck source=agentvm-save
source "$JOB/runtime/agentvm-save"

# The terminals' shell setup ships with every launch, like these scripts: a change needs no new
# image. ~/.zshrc only loads it, so what the user adds there is never overwritten.
if [ -f "$JOB/runtime/zshrc" ]; then
  install -m 644 "$JOB/runtime/zshrc" /etc/agentvm/zshrc
  install -m 644 "$JOB/runtime/starship.toml" /etc/agentvm/starship.toml
  grep -qs "/etc/agentvm/zshrc" /root/.zshrc || install -m 644 "$JOB/runtime/zshrc.stub" /root/.zshrc
fi
# Telemetry for the dashboard, once per second, in every mode.
keep_running /usr/local/bin/agentvm-metrics

# Claude Code's sessions, copied to the host as they grow (only the new bytes): there they
# outlive the VM, for the dashboard's history of the conversation.
copy_transcripts() {
  # One copy at a time: the watcher and a save copying together would append the same bytes twice.
  (
    flock 9 || exit 0
    mkdir -p "$JOB/claude"
    for f in /root/.claude/projects/*/*.jsonl; do
      [ -f "$f" ] || continue
      dest="$JOB/claude/$(basename "$(dirname "$f")")--$(basename "$f")"
      size=$(stat -c %s "$f")
      have=$(stat -c %s "$dest" 2>/dev/null || echo 0)
      if [ "$size" -lt "$have" ]; then
        cp "$f" "$dest.tmp" && mv -f "$dest.tmp" "$dest"
      elif [ "$size" -gt "$have" ]; then
        tail -c +"$((have + 1))" "$f" | head -c "$((size - have))" >> "$dest"
      fi
    done
  ) 9> /run/agentvm-transcripts.lock
}
watch_transcripts() { while true; do copy_transcripts; sleep 2; done; }
keep_running watch_transcripts
log "job start"

if [ ! -s "$JOB/task.json" ]; then
  write_result failed -1 0 no_task
  exit 0
fi

ID=$(jq -r .id "$JOB/task.json")
BRANCH=$(jq -r .branch "$JOB/task.json")
BASE=$(jq -r .base_sha "$JOB/task.json")
MODEL=$(jq -r '.model // empty' "$JOB/task.json")

# Unexported variable: the token reaches Claude only through a pipe (fd 3), never via the environment,
# so the commands run by the agent do not inherit it.
TOKEN=$(cat "$JOB/.token")
rm -f "$JOB/.token"

RESTORE=$(jq -r '.restore // false' "$JOB/task.json")
if [ "$RESTORE" = "true" ]; then
  # Disk from a snapshot: the checkout is already there; continue on this task's branch.
  cd "$WORK"
  # A snapshot taken while git was working keeps its locks; nothing runs git at boot, so they
  # are stale and would make every git command (and this restore) fail.
  rm -f .git/index.lock .git/HEAD.lock .git/config.lock .git/packed-refs.lock
  find .git/refs -name '*.lock' -type f -delete 2>/dev/null || true
  # The work is in the checkout whatever happens here: a save realigns the branch later.
  if ! git checkout -q -B "$BRANCH" 2>> "$JOB/job.log"; then
    log "could not switch to $BRANCH: continuing on $(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)"
  fi
else
  # A new VM always starts from a clean checkout, even if the image holds an old one.
  rm -rf "$WORK"
  # Errors go to job.log: the diagnostics show why a clone failed, not only "exit 128".
  git -c init.defaultBranch=main clone -q "$JOB/repo.bundle" "$WORK" 2>> "$JOB/job.log"
  cd "$WORK"
  git checkout -q -b "$BRANCH" "$BASE" 2>> "$JOB/job.log"
  git config user.name agentvm
  git config user.email agentvm@localhost
fi
log "repo ready on $BRANCH"

for _ in $(seq 100); do getent hosts api.anthropic.com >/dev/null && break; sleep 0.1; done
log "network ready"

# Per-repository setup (dependencies, databases, dev servers): .agentvm/setup.sh, run as root
# in the checkout before Claude starts. Background services it starts keep running.
if [ "$RESTORE" != "true" ] && [ -f "$WORK/.agentvm/setup.sh" ]; then
  log "running .agentvm/setup.sh"
  if (cd "$WORK" && timeout 1800 env HOME=/root PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        bash .agentvm/setup.sh) >> "$JOB/setup.log" 2>&1; then
    log "setup done"
  else
    log "setup failed (see setup.log)"
  fi
  # What setup.sh created (installed dependencies, build output) is not the agent's work: kept out
  # of its commits. Tracked files it changed stay as they are, and are said.
  git -C "$WORK" ls-files --others --exclude-standard --directory -z \
    | while IFS= read -r -d '' f; do printf '/%s\n' "$f"; done >> "$WORK/.git/info/exclude" || true
  changed=$(git -C "$WORK" diff --name-only | head -20 | tr '\n' ' ')
  [ -z "$changed" ] || log "setup.sh changed tracked files (they will be in the agent's commits): $changed"
fi

# A launch can pin another Claude Code release than the image's (the version is validated by the server).
CLAUDE_VERSION=$(jq -r '.claude_version // empty' "$JOB/task.json")
if [ -n "$CLAUDE_VERSION" ]; then
  log "installing Claude Code $CLAUDE_VERSION"
  if ! env -i HOME=/root PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin "$CLAUDE" install "$CLAUDE_VERSION" >> "$JOB/job.log" 2>&1; then
    write_result failed -1 0 "claude_install_failed: $CLAUDE_VERSION"
    exit 0
  fi
  log "Claude Code $("$CLAUDE" --version 2>/dev/null)"
fi

if [ "$(jq -r '.interactive // false' "$JOB/task.json")" = "true" ]; then
  # Terminal: interactive Claude in tmux, PTY server over vsock, save/close on request.
  install -d -m 700 /run/agentvm
  (umask 077; printf '%s' "$TOKEN" > /run/agentvm/token)
  unset TOKEN
  (umask 077; jq -r .prompt "$JOB/task.json" > /run/agentvm/prompt)
  [ "$RESTORE" = "true" ] && touch /run/agentvm/continue
  [ -s /run/agentvm/prompt ] && [ "$(tr -d '[:space:]' < /run/agentvm/prompt)" != "" ] || rm -f /run/agentvm/prompt
  if [ -n "$MODEL" ]; then printf '%s' "$MODEL" > /run/agentvm/model; fi
  keep_running /usr/local/bin/agentvm-pty
  env -i HOME=/root USER=root LANG=C.UTF-8 TERM=xterm-256color PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    tmux -f /etc/agentvm/tmux.conf new-session -d -s claude -c "$WORK" -x 160 -y 48 /usr/local/bin/agentvm-claude
  log "terminal ready"

  # The terminal outlives any single failure (a full disk on the Mac, a request that cannot be
  # answered): the host times out on its side, and the next request is served as usual.
  set +e
  while true; do
    if REQ=$(take_request sync.request); then
      # Snapshot: flush everything to the disk image before the host clones it.
      sync
      reply sync.done "$(jq -nc --arg id "$REQ" '{id:$id}')"
    fi
    if REQ=$(take_request save.request); then
      copy_transcripts
      save_work
      reply save.done "$(jq -nc --arg id "$REQ" --argjson c "$COMMITS" --arg e "$SAVE_ERROR" \
        '{id:$id, commits:$c} + (if $e == "" then {} else {error:$e} end)')"
    fi
    if REQ=$(take_request close.request); then
      log "close requested"
      copy_transcripts
      save_work
      if [ -z "$SAVE_ERROR" ]; then break; fi
      # The final save failed: stay up so nothing is lost, and tell the host why.
      reply close.failed "$(jq -nc --arg id "$REQ" --arg e "$SAVE_ERROR" '{id:$id, error:$e}')"
    fi
    sleep 0.3
  done
  if [ "$COMMITS" -gt 0 ]; then write_result ok 0 "$COMMITS"; else write_result no_changes 0 0; fi
  log "job done"
  exit 0
fi

# The time limit is enforced here, so the work done until then is still saved (exit 124).
TIMEOUT_S=$(jq -r '.timeout_s // 1800' "$JOB/task.json")
# Prompt from stdin: never parsed as an option (e.g. "- list") nor limited by ARG_MAX.
# Claude runs as root (IS_SANDBOX=1: the VM is the sandbox); the token arrives only on fd 3.
# The server's backstop for the time limit counts from this line.
log "claude start"
set +e
jq -r .prompt "$JOB/task.json" | env -i \
  HOME=/root USER=root LANG=C.UTF-8 PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  IS_SANDBOX=1 CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR=3 \
  timeout --kill-after=30 "$TIMEOUT_S" "$CLAUDE" -p --dangerously-skip-permissions ${MODEL:+--model "$MODEL"} --output-format stream-json --verbose \
  3< <(printf '%s' "$TOKEN") > "$JOB/stream.jsonl" 2> "$JOB/claude.err"
CLAUDE_EXIT=${PIPESTATUS[1]}
copy_transcripts || true
set -e
unset TOKEN
log "claude exit $CLAUDE_EXIT"

save_work

if [ -n "$SAVE_ERROR" ]; then
  write_result failed "$CLAUDE_EXIT" "$COMMITS" "$SAVE_ERROR"
elif [ "$CLAUDE_EXIT" -eq 124 ] || [ "$CLAUDE_EXIT" -eq 137 ]; then
  write_result failed "$CLAUDE_EXIT" "$COMMITS" "timeout: the agent ran out of time; its commits are on the branch"
elif [ "$CLAUDE_EXIT" -ne 0 ]; then
  write_result failed "$CLAUDE_EXIT" "$COMMITS"
elif [ "$COMMITS" -eq 0 ]; then
  write_result no_changes 0 0
else
  write_result ok 0 "$COMMITS"
fi
log "job done"
