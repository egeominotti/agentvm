#!/usr/bin/env python3
"""PTY server over vsock (port 5000), run as root in the VM.

Each connection attaches to a persistent root tmux session (`claude` or `shell`),
so reloading the page does not kill Claude. Protocol: one JSON header line
`{"session","cols","rows"}`, then frames from the client `[type:1][length:4 BE][payload]`
(0 = input, 1 = resize JSON `{"cols","rows"}`); to the client, the raw terminal bytes.
"""
import fcntl
import json
import os
import pty
import pwd
import signal
import socket
import struct
import termios
import threading
import time

PORT = 5000
USER = "root"
WORK = "/root/work"
TMUX_CONF = "/etc/agentvm/tmux.conf"
SESSIONS = {
    "claude": ["/usr/local/bin/agentvm-claude"],
    "shell": ["/bin/bash", "-l"],
}


def recv_exact(conn, n):
    buf = b""
    while len(buf) < n:
        chunk = conn.recv(n - len(buf))
        if not chunk:
            return None
        buf += chunk
    return buf


def read_header(conn):
    buf = b""
    while not buf.endswith(b"\n"):
        c = conn.recv(1)
        if not c or len(buf) > 4096:
            return None
        buf += c
    return json.loads(buf)


def set_size(fd, cols, rows):
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))


def spawn(session, cols, rows, view=False):
    pw = pwd.getpwnam(USER)
    if view:
        # Previews watch without typing and without resizing the window for real clients.
        cmd = ["tmux", "-f", TMUX_CONF, "attach-session", "-f", "ignore-size,read-only", "-t", session]
    else:
        cmd = ["tmux", "-f", TMUX_CONF, "new-session", "-A", "-s", session, "-c", WORK] + SESSIONS[session]
    pid, fd = pty.fork()
    if pid == 0:
        env = {
            "HOME": pw.pw_dir, "USER": USER, "LOGNAME": USER, "SHELL": "/bin/bash",
            "TERM": "xterm-256color", "COLORTERM": "truecolor", "LANG": "C.UTF-8",
            "PATH": f"{pw.pw_dir}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
            "IS_SANDBOX": "1",
        }
        # The child must never return into the server: whatever fails here ends it.
        try:
            # The agent may have moved or deleted the checkout: the shell still opens, in /root.
            try:
                os.chdir(WORK)
            except OSError:
                os.chdir(pw.pw_dir)
            os.execvpe(cmd[0], cmd, env)
        finally:
            os._exit(127)
    set_size(fd, cols, rows)
    return pid, fd


def forward(conn, port):
    """Raw byte bridge between the vsock connection and a TCP port inside the VM."""
    try:
        target = socket.create_connection(("127.0.0.1", port), timeout=5)
    except OSError:
        try:
            target = socket.create_connection(("::1", port), timeout=5)
        except OSError:
            conn.close()
            return
    target.settimeout(None)

    def pump(src, dst):
        try:
            while True:
                data = src.recv(65536)
                if not data:
                    break
                dst.sendall(data)
        except OSError:
            pass
        finally:
            for s in (src, dst):
                try:
                    s.shutdown(socket.SHUT_RDWR)
                except OSError:
                    pass

    threading.Thread(target=pump, args=(target, conn), daemon=True).start()
    pump(conn, target)
    target.close()
    conn.close()


def serve(conn):
    pid = fd = None
    try:
        header = read_header(conn)
        if header and isinstance(header.get("forward"), int):
            return forward(conn, header["forward"])
        if not header or header.get("session") not in SESSIONS:
            return
        pid, fd = spawn(header["session"], int(header.get("cols", 120)), int(header.get("rows", 36)), bool(header.get("view")))

        def to_client():
            try:
                while True:
                    data = os.read(fd, 65536)
                    if not data:
                        break
                    conn.sendall(data)
            except OSError:
                pass
            finally:
                try:
                    conn.shutdown(socket.SHUT_RDWR)
                except OSError:
                    pass

        threading.Thread(target=to_client, daemon=True).start()
        while True:
            head = recv_exact(conn, 5)
            if head is None:
                break
            length = struct.unpack(">I", head[1:])[0]
            payload = recv_exact(conn, length) if length else b""
            if payload is None:
                break
            if head[0] == 0:
                os.write(fd, payload)
            elif head[0] == 1:
                size = json.loads(payload)
                set_size(fd, int(size["cols"]), int(size["rows"]))
    except (OSError, ValueError):
        pass
    finally:
        # Closes only the tmux client: the session stays alive for reconnections.
        if pid:
            try:
                os.kill(pid, signal.SIGHUP)
                os.waitpid(pid, 0)
            except OSError:
                pass
        if fd is not None:
            os.close(fd)
        conn.close()


def main():
    srv = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind((socket.VMADDR_CID_ANY, PORT))
    # Room for many terminals opened at once (a wall of previews, several tabs).
    srv.listen(128)
    while True:
        # A failed accept (too many open files, an aborted connection) must not take down the
        # terminals already open with the server: wait a moment and go on.
        try:
            conn, _ = srv.accept()
        except OSError:
            time.sleep(0.2)
            continue
        threading.Thread(target=serve, args=(conn,), daemon=True).start()


if __name__ == "__main__":
    main()
