#!/bin/bash
# agentvm in one command: checks the tools, builds what changed, prepares the VM image the first
# time, starts the server (restarting it on a new build: running VMs re-attach) and opens the
# dashboard. Run it again any time: when nothing changed it takes about a second.
#
#   ./quickstart            build, start, open http://127.0.0.1:7777
#   ./quickstart --dev      the same, plus the dashboard with hot reload (Vite) on :5173
#   ./quickstart --no-open  do not open the browser
set -euo pipefail
cd "$(dirname "$0")"
ROOT=$PWD
HOME_DIR=${AGENTVM_HOME:-$HOME/AgentVMs}
PORT=${AGENTVM_PORT:-7777}
URL="http://127.0.0.1:$PORT"
DEV=0
OPEN=1
for arg in "$@"; do
  case $arg in
    --dev) DEV=1 ;;
    --no-open) OPEN=0 ;;
    -h | --help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option: $arg (see ./quickstart --help)" >&2; exit 2 ;;
  esac
done

# Colors and motion only on a real terminal (not in CI, a pipe or with NO_COLOR).
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  TTY=1
  ink=$'\e[38;2;238;238;240m' ink2=$'\e[38;2;155;158;166m' ink3=$'\e[38;2;99;102;110m'
  brand=$'\e[38;2;116;128;230m' violet=$'\e[38;2;160;140;255m' green=$'\e[38;2;76;183;130m'
  red=$'\e[38;2;235;87;87m' bold=$'\e[1m' off=$'\e[0m' hide=$'\e[?25l' show=$'\e[?25h' clear=$'\e[2K'
else
  TTY=0 ink='' ink2='' ink3='' brand='' violet='' green='' red='' bold='' off='' hide='' show='' clear=''
fi
trap 'printf "%s" "$show"' EXIT
LOGS=$(mktemp -d)
T0=$(perl -MTime::HiRes=time -e 'printf "%.3f", time')
now() { perl -MTime::HiRes=time -e 'printf "%.3f", time'; }
since() { perl -e "printf '%.1fs', $(now) - $1"; }

# The logo: four corner brackets around a sealed cell, the agent inside.
printf '\n'
printf '   %s▛▀    ▀▜%s\n' "$ink" "$off"
printf '   %s▌ %s██%s    %s▐%s   %s%sagentvm%s\n' "$ink" "$violet" "$off" "$ink" "$off" "$bold" "$ink" "$off"
printf '   %s▌ %s██ %s▪%s  %s▐%s   %sEvery terminal is a sealed machine.%s\n' "$ink" "$violet" "$ink3" "$off" "$ink" "$off" "$ink2" "$off"
printf '   %s▙▄    ▄▟%s\n\n' "$ink" "$off"

# run "name" "detail" command…: the command's output goes to a log; a spinner and a clock show it
# works. On failure the end of its log is shown and the script stops.
run() {
  local name=$1 detail=$2 log label
  shift 2
  label=$(printf '%s%-10s%s %s%s%s' "$ink" "$name" "$off" "$ink2" "$detail" "$off")
  log="$LOGS/$(echo "$name" | tr -c 'a-zA-Z0-9' '_').log"
  local start
  start=$(now)
  "$@" >"$log" 2>&1 &
  local pid=$! frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏) i=0
  if [ "$TTY" = 1 ]; then
    printf '%s' "$hide"
    while kill -0 "$pid" 2>/dev/null; do
      printf '\r%s  %s%s%s %s  %s%s%s' "$clear" "$brand" "${frames[i++ % 10]}" "$off" "$label" "$ink3" "$(since "$start")" "$off"
      sleep 0.08
    done
    printf '%s' "$show"
  fi
  if wait "$pid"; then
    printf '\r%s  %s✓%s %s  %s%s%s\n' "$clear" "$green" "$off" "$label" "$ink3" "$(since "$start")" "$off"
  else
    printf '\r%s  %s✗%s %s\n\n' "$clear" "$red" "$off" "$label"
    sed 's/^/      /' "$log" | tail -25 >&2
    printf '\n  %sFull log: %s%s\n\n' "$ink3" "$log" "$off" >&2
    exit 1
  fi
}
note() { printf '  %s·%s %s%s%s\n' "$ink3" "$off" "$ink2" "$*" "$off"; }
fail() { printf '  %s✗ %s%s\n\n' "$red" "$*" "$off" >&2; exit 1; }

check_tools() {
  [ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ] || { echo "agentvm needs a Mac with Apple Silicon"; return 1; }
  command -v swiftc || { echo "swiftc is missing: run  xcode-select --install"; return 1; }
  command -v cargo || { echo "Rust is missing: see https://rustup.rs"; return 1; }
  command -v bun || { echo "Bun is missing: run  curl -fsSL https://bun.sh/install | bash"; return 1; }
  rustup target list --installed 2>/dev/null | grep -q aarch64-apple-darwin || rustup target add aarch64-apple-darwin
}
run Tools "macOS $(sw_vers -productVersion), Swift, Rust, Bun" check_tools

run Build "VM helper, dashboard and server, only what changed" scripts/build.sh

if [ -f "$HOME_DIR/golden/disk.raw" ]; then
  run "VM image" "Debian 13 with Claude Code, ready" true
else
  note "first time only: the VM image is built once, about 2 minutes"
  run "VM image" "Debian 13 with Claude Code" scripts/build-golden.sh
fi

running=$(lsof -t -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -1 || true)
if [ -n "$running" ] && [ "$(basename "$(ps -o comm= -p "$running")")" != agentvm-server ]; then
  fail "port $PORT is taken by another program: $(ps -o comm= -p "$running")"
fi
start_server() {
  if [ -n "$running" ]; then
    # VMs keep running across a restart: the new server re-attaches to them.
    kill "$running"
    for _ in $(seq 1 50); do kill -0 "$running" 2>/dev/null || break; sleep 0.1; done
  fi
  mkdir -p "$HOME_DIR/logs"
  nohup "$ROOT/bin/agentvm-server" >>"$HOME_DIR/logs/server.out" 2>&1 &
  for _ in $(seq 1 100); do
    curl -fs -o /dev/null "$URL/api/status" && return 0
    sleep 0.1
  done
  echo "the server did not answer: see $HOME_DIR/logs/server.out"
  tail -20 "$HOME_DIR/logs/server.out"
  return 1
}
# The running server is current when it started after its binary was last built.
current() {
  local started built
  started=$(LC_ALL=C date -j -f "%a %b %d %T %Y" "$(LC_ALL=C ps -o lstart= -p "$1")" +%s 2>/dev/null || echo 0)
  built=$(stat -f %m bin/agentvm-server)
  [ "$started" -ge "$built" ]
}
if [ -n "$running" ] && current "$running"; then
  run Server "already running, nothing new to load" true
elif [ -n "$running" ]; then
  run Server "restarted on the new build, running VMs re-attach" start_server
else
  run Server "started" start_server
fi

# What the server says about itself, for the summary.
status=$(curl -fs "$URL/api/status" || echo '{}')
field() { echo "$status" | sed -n "s/.*\"$1\":\([a-z0-9]*\).*/\1/p"; }
vms=$(field running)
token=$(field token)
printf '\n  %s%s●%s %s%sagentvm is ready%s  %s%s%s\n\n' "$bold" "$green" "$off" "$bold" "$ink" "$off" "$ink3" "$(since "$T0")" "$off"
printf '    %sDashboard%s   %s%s%s\n' "$ink3" "$off" "$brand$bold" "$URL" "$off"
printf '    %sMachines%s    %s%s running%s\n' "$ink3" "$off" "$ink" "${vms:-0}" "$off"
if [ "$token" = true ]; then
  printf '    %sClaude%s      %stoken in the Keychain%s\n' "$ink3" "$off" "$ink" "$off"
else
  printf '    %sClaude%s      %srun  claude setup-token  and paste it in Settings → Claude account%s\n' "$ink3" "$off" "$violet" "$off"
fi
printf '    %sLogs%s        %s%s/logs%s\n' "$ink3" "$off" "$ink2" "${HOME_DIR/#$HOME/~}" "$off"
if [ "$DEV" = 1 ]; then
  printf '    %sHot reload%s  %shttp://localhost:5173%s  %s(Ctrl-C stops it, the server stays)%s\n\n' "$ink3" "$off" "$brand$bold" "$off" "$ink3" "$off"
  [ "$OPEN" = 1 ] && (sleep 1.5 && open http://localhost:5173) &
  cd web && AGENTVM_API="$URL" exec bun run dev --port 5173 --strictPort
fi
printf '    %sNext%s        %s⌘K in the dashboard launches a VM · ./quickstart --dev for hot reload%s\n\n' "$ink3" "$off" "$ink2" "$off"
[ "$OPEN" = 1 ] && open "$URL"
exit 0
